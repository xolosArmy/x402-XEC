{
  "name": "@x402-xec/agent-bridge",
  "version": "0.1.0",
  "description": "Pure authorization-only bridge connecting x402-XEC to tonalli-agents and RMZWallet",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@x402-xec/core": "0.1.0",
    "@xolosarmy/tonalli-core": "github:xolosArmy/tonalli-core#cfe4cb1575b22ed258565717c000ac535aa98c67",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
