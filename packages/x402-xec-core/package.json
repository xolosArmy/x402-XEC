{
  "name": "@x402-xec/core",
  "version": "0.1.0",
  "description": "Core schemas and local verification for x402-XEC",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./sqlite": {
      "types": "./dist/sqlite-invoice-store.d.ts",
      "import": "./dist/sqlite-invoice-store.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@scure/bip32": "^1.7.0",
    "ecashaddrjs": "^2.0.1",
    "zod": "^4.4.3"
  }
}
